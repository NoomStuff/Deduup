{
   "name": "image-deduplicator",
   "version": "1.0.0",
   "description": "A desktop application to find, review, and safely move duplicate images.",
   "author": "NoomStuff",
   "private": true,
   "type": "module",
   "packageManager": "bun@1.3.10",
   "scripts": {
      "clean": "node scripts/clean.mjs",
      "dev": "tsc -b tsconfig.electron.json --force && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
      "build": "bun run clean && tsc -b --force && vite build",
      "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false bun run build && electron-builder --win portable",
      "lint": "eslint .",
      "format": "prettier --write .",
      "typecheck": "tsc -b --force"
   },
   "main": "dist-electron/main/main.js",
   "dependencies": {
      "lucide-react": "^1.23.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sharp": "^0.35.3"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.4",
      "@types/node": "^24.13.2",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.2.0",
      "concurrently": "^9.2.3",
      "electron": "^37.10.3",
      "electron-builder": "^26.15.3",
      "eslint": "^9.39.4",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react-refresh": "^0.4.26",
      "globals": "^16.5.0",
      "prettier": "^3.9.4",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.63.0",
      "vite": "^7.3.6",
      "wait-on": "^8.0.5"
   },
   "build": {
      "appId": "local.image-deduplicator",
      "productName": "Image Deduplicator",
      "icon": "public/favicon.ico",
      "files": [
         "dist/**",
         "dist-electron/**"
      ],
      "directories": {
         "output": "release"
      },
      "win": {
         "target": [
            "portable"
         ],
         "icon": "public/favicon.ico",
         "signExecutable": false
      }
   }
}
