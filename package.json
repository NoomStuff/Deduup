{
   "name": "image-deduplicator",
   "version": "1.0.0",
   "description": "A desktop application to find, review, and safely move duplicate images.",
   "author": "NoomStuff",
   "private": true,
   "type": "module",
   "packageManager": "bun@1.3.10",
   "scripts": {
      "clean": "node scripts/clean.mjs",
      "dev": "node ./node_modules/typescript/bin/tsc -b tsconfig.electron.json --force && node ./node_modules/concurrently/dist/bin/concurrently.js -k \"node ./node_modules/vite/bin/vite.js --host 127.0.0.1\" \"node ./node_modules/wait-on/bin/wait-on tcp:5173 && node ./node_modules/electron/cli.js .\"",
      "build": "bun run clean && node ./node_modules/typescript/bin/tsc -b --force && node ./node_modules/vite/bin/vite.js build",
      "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false bun run build && node ./node_modules/electron-builder/cli.js --win portable",
      "lint": "node ./node_modules/eslint/bin/eslint.js .",
      "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
      "test": "bun run typecheck && node ./node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test scripts/scanner.test.mjs scripts/fileOperations.test.mjs scripts/reviewModel.test.mjs",
      "test:ui": "bun run build && node scripts/smoke.mjs",
      "fixtures": "node scripts/makeFixtures.mjs",
      "typecheck": "node ./node_modules/typescript/bin/tsc -b --force"
   },
   "main": "dist-electron/main/main.js",
   "dependencies": {
      "@fontsource-variable/quicksand": "^5.3.0",
      "lucide-react": "^1.24.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sharp": "^0.35.3"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@types/node": "^24.13.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.2.0",
      "concurrently": "^9.2.4",
      "electron": "^43.1.1",
      "electron-builder": "^26.15.3",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react-refresh": "^0.4.26",
      "globals": "^16.5.0",
      "playwright-core": "^1.62.1",
      "prettier": "^3.9.5",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.64.0",
      "vite": "^7.3.6",
      "wait-on": "^8.0.5"
   },
   "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.3.0",
      "tar": "7.5.20",
      "tmp": "0.2.7"
   },
   "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
   },
   "build": {
      "appId": "local.image-deduplicator",
      "productName": "Image Deduplicator",
      "icon": "public/favicon.ico",
      "files": [
         "dist/**",
         "dist-electron/**"
      ],
      "directories": {
         "output": "release"
      },
      "win": {
         "target": [
            "portable"
         ],
         "icon": "public/favicon.ico",
         "signExecutable": false
      }
   }
}
