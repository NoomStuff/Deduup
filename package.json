{
   "name": "deduup",
   "version": "0.4.0",
   "description": "Find and review redundant images locally",
   "author": "NoomStuff",
   "license": "MIT",
   "homepage": "https://github.com/NoomStuff/Deduup#readme",
   "bugs": "https://github.com/NoomStuff/Deduup/issues",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/NoomStuff/Deduup.git"
   },
   "private": false,
   "type": "module",
   "packageManager": "bun@1.4.2",
   "scripts": {
      "clean": "node scripts/clean.mjs",
      "dev": "tsc -b tsconfig.electron.json && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
      "build": "tsc -b && vite build",
      "build:icons": "node scripts/build-icons.mjs",
      "dist": "node scripts/package-app.mjs dist",
      "dist:win": "node scripts/package-app.mjs dist win32",
      "dist:win:installer": "node scripts/package-app.mjs dist win32 installer",
      "dist:win:all": "node scripts/package-app.mjs dist win32 all",
      "dist:mac": "node scripts/package-app.mjs dist darwin",
      "dist:linux": "node scripts/package-app.mjs dist linux",
      "package": "node scripts/package-app.mjs package",
      "verify:package": "node scripts/verify-package.mjs",
      "release": "bun scripts/release.mjs",
      "open": "node scripts/open.mjs",
      "lint": "eslint . --max-warnings 0",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "bun run typecheck && node scripts/run-tests.mjs",
      "verify": "bun run format:check && bun run lint && bun run test && bun run test:ui",
      "test:ui": "bun run build && node scripts/run-ui-tests.mjs",
      "fixtures": "node scripts/makeFixtures.mjs",
      "bench:scanner": "bun scripts/scanner.bench.mjs",
      "typecheck": "tsc -b"
   },
   "main": "build/electron/main/main.js",
   "dependencies": {
      "@fontsource-variable/nunito": "5.3.0",
      "electron-updater": "6.8.11",
      "lucide-react": "1.72.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "sharp": "0.35.5",
      "zod": "4.6.7"
   },
   "devDependencies": {
      "@eslint/js": "10.0.1",
      "@types/node": "24.19.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "5.2.0",
      "concurrently": "10.0.7",
      "electron": "45.3.0",
      "electron-builder": "26.18.0",
      "eslint": "10.14.0",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-react-hooks": "7.1.1",
      "eslint-plugin-react-refresh": "0.5.7",
      "globals": "17.14.0",
      "playwright-core": "1.65.0",
      "png-to-ico": "3.0.2",
      "prettier": "3.10.0",
      "typescript": "6.0.3",
      "typescript-eslint": "8.72.2",
      "vite": "7.3.8",
      "wait-on": "8.0.5"
   },
   "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.3.0",
      "tar": "7.5.20",
      "tmp": "0.2.7"
   },
   "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
   }
}
