{
   "name": "deduup",
   "version": "0.1.4",
   "description": "Clear your copies with ease",
   "author": "NoomStuff",
   "license": "MIT",
   "homepage": "https://github.com/NoomStuff/Deduup#readme",
   "bugs": "https://github.com/NoomStuff/Deduup/issues",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/NoomStuff/Deduup.git"
   },
   "private": false,
   "type": "module",
   "packageManager": "bun@1.3.10",
   "scripts": {
      "clean": "node scripts/clean.mjs",
      "dev": "tsc -b tsconfig.electron.json --force && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
      "build": "bun run clean && tsc -b --force && vite build",
      "build:icons": "node scripts/build-icons.mjs",
      "dist": "node scripts/package-app.mjs dist",
      "dist:win": "node scripts/package-app.mjs dist win32",
      "dist:win:installer": "node scripts/package-app.mjs dist win32 installer",
      "dist:win:all": "node scripts/package-app.mjs dist win32 all",
      "dist:mac": "node scripts/package-app.mjs dist darwin",
      "dist:linux": "node scripts/package-app.mjs dist linux",
      "package": "node scripts/package-app.mjs package",
      "verify:package": "node scripts/verify-package.mjs",
      "open": "node scripts/open.mjs",
      "lint": "eslint . --max-warnings 0",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "bun run typecheck && node scripts/run-tests.mjs",
      "verify": "bun run format:check && bun run lint && bun run test && bun run test:ui",
      "test:ui": "bun run build && node scripts/smoke.mjs && node scripts/fileWorkflow.smoke.mjs && node scripts/libraryRefresh.smoke.mjs",
      "fixtures": "node scripts/makeFixtures.mjs",
      "typecheck": "tsc -b --force"
   },
   "main": "build/electron/main/main.js",
   "dependencies": {
      "@fontsource-variable/nunito": "^5.3.0",
      "electron-updater": "^6.7.3",
      "lucide-react": "^1.24.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sharp": "^0.35.3"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@types/node": "^24.13.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.2.0",
      "concurrently": "^9.2.4",
      "electron": "^43.1.1",
      "electron-builder": "^26.15.3",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react-refresh": "^0.4.26",
      "globals": "^16.5.0",
      "playwright-core": "^1.62.1",
      "png-to-ico": "^3.0.2",
      "prettier": "^3.9.5",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.64.0",
      "vite": "^7.3.6",
      "wait-on": "^8.0.5"
   },
   "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.3.0",
      "tar": "7.5.20",
      "tmp": "0.2.7"
   },
   "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
   }
}
