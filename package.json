{
   "name": "image-deduplicator",
   "version": "2.0.0",
   "description": "A desktop application to find, review, and safely move duplicate images.",
   "author": "NoomStuff",
   "private": true,
   "type": "module",
   "packageManager": "bun@1.3.10",
   "scripts": {
      "clean": "node scripts/clean.mjs",
      "dev": "tsc -b tsconfig.electron.json --force && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
      "build": "bun run clean && tsc -b --force && vite build",
      "dist": "bun run build && electron-builder --publish never",
      "dist:win": "bun run build && electron-builder --win --publish never",
      "dist:mac": "bun run build && electron-builder --mac --publish never",
      "dist:linux": "bun run build && electron-builder --linux --publish never",
      "open": "node scripts/open.mjs",
      "lint": "eslint . --max-warnings 0",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "bun run typecheck && bun test scripts",
      "verify": "bun run format:check && bun run lint && bun run test && bun run test:ui",
      "test:ui": "bun run build && node scripts/smoke.mjs && node scripts/fileWorkflow.smoke.mjs && node scripts/libraryRefresh.smoke.mjs",
      "fixtures": "node scripts/makeFixtures.mjs",
      "typecheck": "tsc -b --force"
   },
   "main": "build/electron/main/main.js",
   "dependencies": {
      "@fontsource-variable/nunito": "^5.3.0",
      "lucide-react": "^1.24.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sharp": "^0.35.3"
   },
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@types/node": "^24.13.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.2.0",
      "concurrently": "^9.2.4",
      "electron": "^43.1.1",
      "electron-builder": "^26.15.3",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-react-hooks": "^5.2.0",
      "eslint-plugin-react-refresh": "^0.4.26",
      "globals": "^16.5.0",
      "playwright-core": "^1.62.1",
      "prettier": "^3.9.5",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.64.0",
      "vite": "^7.3.6",
      "wait-on": "^8.0.5"
   },
   "overrides": {
      "@babel/core": "7.29.7",
      "esbuild": "0.28.1",
      "form-data": "4.0.6",
      "js-yaml": "4.3.0",
      "tar": "7.5.20",
      "tmp": "0.2.7"
   },
   "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
   }
}
